# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Luau and config files
*.luau text diff=lua
*.lua text diff=lua
*.toml text
*.json text
*.md text

# Binary Roblox, 3D, Audio, and Image assets
*.rbxm binary
*.rbxmx text
*.rbxl binary
*.rbxlx text
*.blend binary
*.fbx binary
*.ogg binary
*.png binary
*.psd binary
