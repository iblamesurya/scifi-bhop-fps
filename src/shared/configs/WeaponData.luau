	[1] = VortexSmgStats,
	[2] = HeliosRailStats,
	[3] = PlasmaShotgunStats,
	[4] = IonSidearmStats,
})

local DefaultLoadout = table.freeze({
	"VORTEX_SMG",
	"HELIOS_RAIL",
	"PlasmaShotgun",
	"IonSidearm",
})

local WeaponData = {
	Weapons = Weapons,
	VORTEX_SMG = VortexSmgStats,
	PulseRifle = VortexSmgStats,
	HELIOS_RAIL = HeliosRailStats,
	Railgun = HeliosRailStats,
	PlasmaShotgun = PlasmaShotgunStats,
	IonSidearm = IonSidearmStats,
	ADSFov = 70,
	DefaultLoadout = DefaultLoadout,
	DefaultWeaponId = "VORTEX_SMG",

	GetWeapon = function(weaponId: string): WeaponStats?
		return Weapons[weaponId]
	end,

	GetWeaponByNumericId = function(id: number): WeaponStats
		return NumericWeaponLookup[id] or VortexSmgStats
	end,
}

return table.freeze(WeaponData)
