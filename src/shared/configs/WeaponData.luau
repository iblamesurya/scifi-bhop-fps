--!strict
--[[
	WeaponData.luau
	Read-only weapon balance, recoil spring parameters, spread, ADS settings, and asset bindings.
	Includes compatibility aliases for WeaponController, CombatValidator, ViewmodelController, and GraphicsController.
]]

export type WeaponStats = {
	Id: string,
	WeaponId: number,
	DisplayName: string,
	Slot: number,
	Automatic: boolean,
	FireRateRPM: number,
	RPM: number,
	FireRate: number,
	FireInterval: number,
	BaseDamage: number,
	Damage: number,
	HeadshotMultiplier: number,
	MaxRange: number,
	Range: number,
	Pellets: number,
	BaseSpreadRad: number,
	MoveSpreadPenaltyRad: number,
	MagazineSize: number,
	MaxAmmo: number,
	ReloadTime: number,
	EquipTime: number,
	RecoilKickPos: Vector3,
	RecoilKick: Vector3,
	RecoilKickRot: Vector3,
	CameraRecoilPitch: number,
	CameraRecoilYaw: number,
	AimSpeed: number,
	ADSFov: number,
	IsOverdrive: boolean,
	TracerColor: Color3,
	ViewmodelKey: string,
	WorldmodelKey: string,
	FireSoundKey: string,
	ReloadSoundKey: string,
	IconKey: string,
}

export type WeaponMap = { [string]: WeaponStats }

